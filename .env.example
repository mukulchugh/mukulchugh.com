# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Analytics (Optional)
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-VTWNXFFM1L

# PostHog: public project token, never a personal API key.
# Defaults to the public token for portfolio project 625612 in lib/analytics-config.ts.
# Optional override. Browser traffic always uses /api/analytics/posthog.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Google AdSense Publisher ID
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Contact Email (Optional)
# Email address for contact form submissions
CONTACT_EMAIL=contact@example.com

# Site URL (Production)
# Full URL of your production site
NEXT_PUBLIC_SITE_URL=https://mukulchugh.com
